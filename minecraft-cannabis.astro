---
import BaseLayout from "../../layouts/BaseLayout.astro";
const repo = "https://github.com/AVIX-afk/Minecraft-Cannabis";
---
<BaseLayout title="Minecraft Cannabis" description="A vanilla-style Minecraft Java Edition Fabric mod featuring twelve strains, crop growing, cross-breeding, crafting, and discovery.">
  <section class="container project-hero">
    <a class="back-link" href="/#projects">← All projects</a>
    <p class="eyebrow">Featured project · Fabric mod</p>
    <h1>Minecraft<br /><span>Cannabis.</span></h1>
    <p class="lead">Grow it, roll it, cook it. A vanilla-style farming and crafting mod for Minecraft Java Edition—built around discovery, progression, and fitting naturally into the game.</p>
    <div class="button-row">
      <a class="button primary" href={`${repo}/releases/latest`} target="_blank" rel="noreferrer">Download latest release ↗</a>
      <a class="button" href={repo} target="_blank" rel="noreferrer">View source on GitHub ↗</a>
    </div>
    <div class="project-visual" role="img" aria-label="Abstract green pixel-inspired artwork representing crop growth">
      <div class="visual-ring ring-a"></div><div class="visual-ring ring-b"></div>
      <div class="crop-shape"><span></span><i></i><b></b><em></em><strong></strong></div>
      <div class="visual-tag">GROW · CROSS · DISCOVER</div>
    </div>
  </section>

  <section class="container section">
    <div class="section-title"><p class="eyebrow">The idea</p><h2>Familiar systems.<br />A new layer of discovery.</h2></div>
    <div class="feature-grid">
      <article class="feature card"><span class="feature-icon">✳</span><h3>Grow and harvest</h3><p class="muted">Twelve strains across three tiers, with distinct crop stages and a progression loop built around growing and collecting.</p></article>
      <article class="feature card"><span class="feature-icon">⌘</span><h3>Cross-breed and research</h3><p class="muted">Use the Mixing Table, catalysts, and Research Journal to discover new strains instead of simply finding every seed in the world.</p></article>
      <article class="feature card"><span class="feature-icon">◇</span><h3>Craft your way</h3><p class="muted">Make joints, blunts, Thai Sticks, bongs, concentrates, and edibles using familiar Minecraft-style crafting and brewing systems.</p></article>
    </div>
  </section>

  <section class="container section details">
    <div><p class="eyebrow">Getting started</p><h2>Install the mod.</h2><p class="muted">Check the current release notes before installing so your Minecraft, Fabric Loader, and Fabric API versions match the release requirements.</p></div>
    <div class="resource-list">
      <a href={`${repo}/releases/latest`} target="_blank" rel="noreferrer"><span><strong>Latest release</strong><small>Official downloads and checksums</small></span><b>↗</b></a>
      <a href={`${repo}#installing`} target="_blank" rel="noreferrer"><span><strong>Installation guide</strong><small>Requirements and setup steps</small></span><b>↗</b></a>
      <a href={`${repo}/blob/main/CHANGELOG.md`} target="_blank" rel="noreferrer"><span><strong>Changelog</strong><small>Changes tracked in the repository</small></span><b>↗</b></a>
      <a href={`${repo}/issues`} target="_blank" rel="noreferrer"><span><strong>Bug reports and ideas</strong><small>Report problems or suggest improvements</small></span><b>↗</b></a>
    </div>
  </section>
  <section class="container disclaimer"><p class="muted">This is a fictional game mechanic for Minecraft. It is not an official Minecraft product and is not approved by or associated with Mojang or Microsoft. See the repository for full license and usage terms.</p></section>
</BaseLayout>

<style>
  .project-hero { padding-top: 38px; }
  .back-link { display: inline-block; margin-bottom: 48px; color: var(--muted); font-size: .88rem; }
  .back-link:hover { color: var(--accent); }
  h1 { margin: 20px 0 20px; }.project-hero h1 span { color: var(--accent); }
  .lead { max-width: 680px; color: var(--muted); font-size: 1.15rem; }
  .project-visual { position: relative; display: grid; place-items: center; min-height: 300px; margin-top: 48px; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; background: radial-gradient(ellipse at 50% 65%, #3d633a, #1c2b20 47%, #141a16 78%); }
  .visual-ring { position: absolute; width: 310px; height: 220px; border: 1px solid #b9f28c38; border-radius: 50%; transform: rotate(25deg); }
  .ring-b { width: 240px; height: 320px; transform: rotate(-25deg); }
  .crop-shape { z-index: 1; position: relative; width: 18px; height: 115px; background: #b9f28c; box-shadow: 0 60px 0 -3px #639b51; }
  .crop-shape span, .crop-shape i, .crop-shape b, .crop-shape em, .crop-shape strong { position: absolute; display: block; width: 72px; height: 22px; background: #84c967; }
  .crop-shape span { left: -58px; top: 12px; transform: rotate(25deg); }.crop-shape i { left: 4px; top: 31px; transform: rotate(-35deg); background: #4e944d; }.crop-shape b { left: -52px; top: 54px; transform: rotate(22deg); background: #74b95d; }.crop-shape em { left: 7px; top: 70px; transform: rotate(-30deg); background: #a0db73; }.crop-shape strong { left: -28px; top: -12px; width: 48px; height: 18px; transform: rotate(-20deg); background: #b9f28c; }
  .visual-tag { position: absolute; bottom: 22px; left: 24px; color: #d5e5d1; font-size: .65rem; letter-spacing: .16em; }
  .section { padding-top: 72px; }.section-title { margin-bottom: 28px; }.section-title h2 { margin-bottom: 0; }
  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .feature { padding: 25px; }.feature-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--accent-dark); color: var(--accent); font-size: 1.2rem; margin-bottom: 28px; }.feature h3 { font-size: 1.12rem; }.feature p { margin-bottom: 0; font-size: .9rem; }
  .details { display: grid; grid-template-columns: .85fr 1.15fr; gap: 50px; border-top: 1px solid var(--line); margin-top: 25px; }.details h2 { margin-bottom: 16px; }
  .resource-list { border-top: 1px solid var(--line); }.resource-list a { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 17px 0; border-bottom: 1px solid var(--line); }.resource-list a:hover strong, .resource-list a:hover b { color: var(--accent); }.resource-list strong, .resource-list small { display: block; }.resource-list small { margin-top: 3px; color: var(--muted); }.resource-list b { color: var(--muted); }
  .disclaimer { padding-top: 38px; max-width: 850px; font-size: .8rem; }
  @media (max-width: 760px) { .feature-grid { grid-template-columns: 1fr; }.details { grid-template-columns: 1fr; gap: 22px; }.back-link { margin-bottom: 35px; }.project-visual { min-height: 250px; } }
</style>
