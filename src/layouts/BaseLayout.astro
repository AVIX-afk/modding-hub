---
import "../styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { studio } from "../site.config";
import { href } from "../lib/url";
import Icon from "../components/Icon.astro";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  accent?: string;
}
const { title, description = studio.description, image, accent } = Astro.props;
const pageTitle = title ? `${title} | ${studio.name}` : `${studio.name}: ${studio.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL((await getImage({ src: image, width: 1200, format: "png" })).src, Astro.site) : undefined;

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const nav = [
  { label: "Projects", to: "/projects/" },
  { label: "About", to: "/about/" },
];
const isCurrent = (to: string) => path === to || path.startsWith(to) ? "page" : undefined;
const year = new Date().getFullYear();
const social = [
  studio.links.discord && { name: "discord" as const, label: "Discord", url: studio.links.discord },
  studio.links.youtube && { name: "youtube" as const, label: "YouTube", url: studio.links.youtube },
  studio.links.x && { name: "x" as const, label: "X", url: studio.links.x },
  { name: "github" as const, label: "GitHub", url: studio.links.github },
].filter(Boolean) as { name: "discord" | "youtube" | "x" | "github"; label: string; url: string }[];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <meta name="theme-color" content="#15171c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:title" content={title ?? studio.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
  </head>
  <body style={accent ? `--accent: ${accent}` : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={href("/")} aria-label={`${studio.name} home`}>
          <svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="var(--studio)"/><path d="M8.5 24.5 16 7.5l7.5 17h-4.6L16 17.6l-2.9 6.9z" fill="var(--bg)"/></svg>
          <span>{studio.name}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => <li><a href={href(n.to)} aria-current={isCurrent(n.to)}>{n.label}</a></li>)}
          </ul>
          <ul class="social">
            {social.map((s) => (
              <li><a href={s.url} rel="noopener" target="_blank" title={s.label}><Icon name={s.name} label={s.label} /></a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <a class="brand small" href={href("/")}>
            <svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="var(--studio)"/><path d="M8.5 24.5 16 7.5l7.5 17h-4.6L16 17.6l-2.9 6.9z" fill="var(--bg)"/></svg>
            <span>{studio.name}</span>
          </a>
          <p class="muted">{studio.tagline}</p>
        </div>
        <ul class="foot-links">
          <li><a href={href("/projects/")}>Projects</a></li>
          <li><a href={href("/about/")}>About</a></li>
          {social.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
        </ul>
        <p class="muted copy">© {studio.founded === year ? year : `${studio.founded}–${year}`} {studio.name}. Game names and trademarks belong to their owners.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: 12px; top: -60px; padding: 8px 14px; background: var(--studio); color: var(--on-studio); border-radius: 6px; font-weight: 700; z-index: 10; }
  .skip:focus { top: 12px; }

  .site-header { border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5;
    background: color-mix(in oklab, var(--bg) 88%, transparent); backdrop-filter: blur(10px); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 800; font-stretch: var(--wide); font-size: 1.02rem; letter-spacing: -0.01em; }
  .brand.small { font-size: 0.95rem; }
  .mark { width: 28px; height: 28px; flex: none; }
  nav { display: flex; align-items: center; gap: 8px; }
  nav ul { display: flex; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 12px; border-radius: 8px; color: var(--muted); text-decoration: none; font-weight: 600; font-size: 0.95rem; }
  nav a:hover { color: var(--text); background: var(--surface); }
  nav a[aria-current="page"] { color: var(--text); }
  .social { padding-left: 8px !important; margin-left: 4px !important; border-left: 1px solid var(--line) !important; }
  .social a { padding: 0 10px; }
  .social :global(svg) { width: 20px; height: 20px; }

  .site-footer { border-top: 1px solid var(--line); margin-top: 32px; }
  .foot { display: grid; grid-template-columns: 1fr auto; gap: 20px 40px; padding-block: 40px 32px; }
  .foot p { margin-top: 8px; font-size: var(--step--1); }
  .foot-links { display: flex; flex-wrap: wrap; gap: 6px 22px; list-style: none; margin: 0; padding: 0; font-size: var(--step--1); }
  .foot-links a { color: var(--muted); text-decoration: none; }
  .foot-links a:hover { color: var(--text); }
  .copy { grid-column: 1 / -1; padding-top: 20px; border-top: 1px solid var(--line); }

  @media (max-width: 560px) {
    nav a { padding: 0 9px; }
    .foot { grid-template-columns: 1fr; }
  }
  @media (max-width: 370px) {
    .bar .brand span { display: none; }
  }
</style>
