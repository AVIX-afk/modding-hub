---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { allProjects, pluralKind, slugify } from "../../lib/projects";
import { studio } from "../../site.config";

const projects = await allProjects();
// Only offer filters that match at least one project, in the order projects appear.
const kinds = [...new Set(projects.map((p) => p.data.kind))];
const platforms = [...new Set(projects.map((p) => p.data.platformGroup))].filter((g) => g !== "Other");
---
<BaseLayout title="Projects" description={`Every mod, game and tool from ${studio.name}, with downloads, guides and requirements.`}>
  <section class="wrap head">
    <h1 class="display">Projects</h1>
    <p class="muted">Every mod, game and tool we've released or are building. Open one for downloads, requirements and its guide.</p>
  </section>

  <section class="wrap list" aria-label="All projects">
    {(kinds.length > 1 || platforms.length > 1) && (
      <div class="filters">
        {kinds.length > 1 && (
          <div class="filter-row" role="group" aria-label="Filter by type">
            <span class="filter-label">Type</span>
            <button type="button" aria-pressed="true" data-filter="type" data-value="all">All</button>
            {kinds.map((k) => <button type="button" aria-pressed="false" data-filter="type" data-value={slugify(k)}>{pluralKind(k)}</button>)}
          </div>
        )}
        {platforms.length > 1 && (
          <div class="filter-row" role="group" aria-label="Filter by platform">
            <span class="filter-label">Platform</span>
            <button type="button" aria-pressed="true" data-filter="platform" data-value="all">All</button>
            {platforms.map((g) => <button type="button" aria-pressed="false" data-filter="platform" data-value={slugify(g)}>{g}</button>)}
          </div>
        )}
      </div>
    )}
    <p class="count muted" aria-live="polite">{projects.length} {projects.length === 1 ? "project" : "projects"}</p>
    <div class="grid">
      {projects.map((p) => (
        <div class="item" data-type={slugify(p.data.kind)} data-platform={slugify(p.data.platformGroup)}>
          <ProjectCard project={p} headingLevel={2} />
        </div>
      ))}
    </div>
    <p class="none muted" hidden>Nothing here yet. <button type="button" class="reset">Show all projects</button></p>
  </section>
</BaseLayout>

<script>
  // Filters live in the address (/projects/?type=tool&platform=windows) so a
  // filtered view can be linked from the homepage or shared.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>(".filters button")];
  const items = [...document.querySelectorAll<HTMLElement>(".item")];
  const count = document.querySelector<HTMLElement>(".count")!;
  const none = document.querySelector<HTMLElement>(".none")!;

  function apply(state: Record<string, string>) {
    for (const b of buttons) {
      const current = state[b.dataset.filter!] ?? "all";
      b.setAttribute("aria-pressed", String(b.dataset.value === current));
    }
    let shown = 0;
    for (const el of items) {
      const match = Object.entries(state).every(([key, value]) => value === "all" || el.dataset[key] === value);
      el.hidden = !match;
      if (match) shown++;
    }
    count.textContent = `${shown} ${shown === 1 ? "project" : "projects"}`;
    none.hidden = shown > 0;
  }

  function read(): Record<string, string> {
    const params = new URLSearchParams(location.search);
    const state: Record<string, string> = {};
    for (const key of ["type", "platform"]) {
      const value = params.get(key);
      // Ignore values that don't match a button, such as an old link.
      state[key] = value && buttons.some((b) => b.dataset.filter === key && b.dataset.value === value) ? value : "all";
    }
    return state;
  }

  function write(state: Record<string, string>) {
    const params = new URLSearchParams();
    for (const [key, value] of Object.entries(state)) if (value !== "all") params.set(key, value);
    const query = params.toString();
    history.replaceState(null, "", query ? `?${query}` : location.pathname);
  }

  let state = read();
  apply(state);
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      state = { ...state, [btn.dataset.filter!]: btn.dataset.value! };
      apply(state);
      write(state);
    }),
  );
  document.querySelector(".reset")?.addEventListener("click", () => {
    state = { type: "all", platform: "all" };
    apply(state);
    write(state);
  });
</script>

<style>
  .head { padding-block: clamp(48px, 8vw, 96px) 32px; display: grid; gap: 16px; }
  h1 { font-size: var(--step-4); }
  .head p { font-size: var(--step-1); max-width: 52ch; }
  .list { padding-bottom: 72px; }
  .filters { display: grid; gap: 10px; margin-bottom: 20px; }
  .filter-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .filter-label { width: 5.5rem; font-size: var(--step--1); color: var(--muted); font-weight: 600; }
  .filters button { font: inherit; font-weight: 600; font-size: 0.92rem; min-height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line); background: none; color: var(--muted); cursor: pointer; }
  .filters button:hover { color: var(--text); border-color: #3b4050; }
  .filters button[aria-pressed="true"] { background: var(--text); border-color: var(--text); color: var(--bg); }
  .count { font-size: var(--step--1); margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 20px; }
  .item { display: grid; }
  .item[hidden] { display: none; }
  .none { padding-block: 24px; }
  .reset { font: inherit; color: var(--text); background: none; border: 0; padding: 0; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  @media (max-width: 560px) {
    .filter-label { width: 100%; }
  }
</style>
