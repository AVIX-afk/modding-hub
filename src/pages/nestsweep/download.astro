---
// afkbird.com/nestsweep/download always starts the newest Nestsweep.exe download.
// GitHub's /releases/latest/download/ link follows each new release on its own.
import { getEntry } from "astro:content";
import { href } from "../../lib/url";
const project = await getEntry("projects", "nestsweep");
const target = project?.data.links.download ?? "https://github.com/afkbirdgames/nestsweep/releases/latest";
const page = href("/projects/nestsweep/");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Downloading Nestsweep</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={page} />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #15171c; color: #eceef2; font-family: system-ui, sans-serif; padding: 16px; text-align: center; line-height: 1.6; }
      a { color: #f0b13e; }
    </style>
  </head>
  <body>
    <p>Your Nestsweep download is starting. <a href={target}>Download it here</a> if nothing happens.<br />
      If Windows shows "Windows protected your PC", click More info, then Run anyway.<br />
      <a href={page}>About Nestsweep</a></p>
  </body>
</html>
