---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ServerList from "../components/ServerList.astro";
import Icon from "../components/Icon.astro";
import Community from "../components/Community.astro";
import LatestVideos from "../components/LatestVideos.astro";
import { allProjects, allServers } from "../lib/projects";
import { latestRelease, formatDate } from "../lib/releases";
import { studio } from "../site.config";
import { href } from "../lib/url";

const projects = await allProjects();
const servers = allServers();
const featured = projects.filter((p) => p.data.featured);
const shown = featured.length ? featured : projects;

// The release board: every project with a GitHub release, newest first.
const board = (
  await Promise.all(projects.map(async (p) => ({ project: p, release: await latestRelease(p.data.repo) })))
)
  .filter((r) => r.release)
  .sort((a, b) => b.release!.publishedAt.getTime() - a.release!.publishedAt.getTime())
  .slice(0, 4);
---
<BaseLayout>
  <section class="hero wrap">
    <div class="intro">
      <h1 class="display">Mods, games and tools, built in the open.</h1>
      <p class="lead muted">
        {studio.name} is an independent studio making things for the games people already play, and a few of its own.
        Every download here goes straight to its official GitHub release.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href={href("/projects/")}>Browse projects</a>
        {studio.links.discord
          ? <a class="btn" href={studio.links.discord} rel="noopener" target="_blank"><Icon name="discord" />Join the Discord</a>
          : <a class="btn" href={studio.links.github} rel="noopener" target="_blank"><Icon name="github" />Follow on GitHub</a>}
      </div>
    </div>

    <aside class="board" aria-labelledby="board-title">
      <h2 id="board-title">Latest releases</h2>
      {board.length ? (
        <ol>
          {board.map(({ project, release }) => (
            <li style={`--accent: ${project.data.accent}`}>
              <a href={href(`/projects/${project.id}/`)}>
                <span class="swatch" aria-hidden="true"></span>
                <span class="name">{project.data.title}<small class="muted">{project.data.platform}</small></span>
                <span class="ver">
                  <strong>{release!.version}</strong>
                  <small class="muted"><time datetime={release!.publishedAt.toISOString()}>{formatDate(release!.publishedAt)}</time></small>
                </span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="muted empty">Releases appear here as soon as a project publishes one on GitHub.</p>
      )}
      <p class="board-foot muted">Versions update automatically from GitHub. <a href={studio.links.github} rel="noopener" target="_blank">Follow releases</a></p>
    </aside>
  </section>

  <section class="section wrap" aria-labelledby="projects-title">
    <div class="section-head">
      <h2 id="projects-title">Projects</h2>
      <a class="all" href={href("/projects/")}>All projects</a>
    </div>
    <div class:list={["grid", { stack: shown.length <= 2 }]}>
      {shown.map((p) => <ProjectCard project={p} wide={shown.length <= 2} />)}
    </div>
  </section>

  {servers.length > 0 && (
    <section class="section wrap" aria-labelledby="servers-title">
      <div class="section-head">
        <h2 id="servers-title">Servers</h2>
        <p class="muted">Live status for the servers we run. Open a server's guide to get whitelisted and join.</p>
      </div>
      <ServerList servers={servers} />
    </section>
  )}

  <LatestVideos />

  <section class="section wrap" aria-labelledby="community-title">
    <div class="section-head">
      <h2 id="community-title">Community</h2>
      <p class="muted">News lands on Discord first, then on X and YouTube.</p>
    </div>
    <Community />
  </section>

  <section class="section wrap studio" aria-labelledby="about-title">
    <div>
      <h2 id="about-title" class="display">One developer.<br />Every project shipped properly.</h2>
    </div>
    <div class="studio-copy">
      <p>
        Each project gets real documentation, versioned releases and an issue tracker, whether it's a mod, a game or a
        small tool. When something breaks, you can report it in the open and follow the fix.
      </p>
      <a class="btn" href={href("/about/")}>About the studio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: end; padding-block: clamp(48px, 9vw, 112px) clamp(32px, 5vw, 56px); }
  h1 { font-size: var(--step-4); line-height: 1.02; max-width: 15ch; }
  .lead { margin-block: 24px 32px; font-size: var(--step-1); line-height: 1.55; max-width: 46ch; }

  .board { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 22px 16px; }
  .board h2 { font-size: var(--step-1); margin-bottom: 12px; }
  .board ol { list-style: none; margin: 0; padding: 0; }
  .board li + li { border-top: 1px solid var(--line); }
  .board ol a { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; padding: 14px 8px; margin-inline: -8px; border-radius: 8px; text-decoration: none; }
  .board ol a:hover { background: var(--surface-2); }
  .swatch { width: 10px; height: 40px; border-radius: 3px; background: var(--accent); }
  .name { display: grid; font-weight: 750; font-size: var(--step-1); line-height: 1.25; }
  .name small, .ver small { font-size: var(--step--1); font-weight: 450; }
  .ver { display: grid; justify-items: end; line-height: 1.3; }
  .ver strong { font-stretch: var(--wide); font-size: var(--step-1); }
  .empty { padding-block: 8px 12px; }
  .board-foot a { color: var(--text); text-underline-offset: 3px; }
  .board-foot { margin-top: 10px; padding-top: 12px; border-top: 1px solid var(--line); font-size: var(--step--1); }

  .all { color: var(--muted); font-weight: 600; text-underline-offset: 4px; }
  .all:hover { color: var(--text); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 20px; }
  .grid.stack { grid-template-columns: 1fr; }

  .studio { display: grid; grid-template-columns: 1fr 1fr; gap: 32px clamp(32px, 6vw, 80px); align-items: start; border-top: 1px solid var(--line); }
  .studio h2 { font-size: var(--step-3); line-height: 1.08; }
  .studio-copy { display: grid; gap: 24px; justify-items: start; }
  .studio-copy p { font-size: var(--step-1); line-height: 1.55; color: var(--muted); max-width: 48ch; }

  @media (max-width: 860px) {
    .hero, .studio { grid-template-columns: 1fr; }
  }
</style>
