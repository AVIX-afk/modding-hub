---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServerList from "../../components/ServerList.astro";
import Icon from "../../components/Icon.astro";
import { allServers } from "../../lib/projects";
import { href, isExternal } from "../../lib/url";
import { studio } from "../../site.config";

export function getStaticPaths() {
  return allServers()
    .filter((s) => s.join)
    .map((server) => ({ params: { id: server.id }, props: { server } }));
}

const { server } = Astro.props;
const join = server.join!;
const steps: { title: string; kind: "whitelist" | "install" | "add" }[] = [];
if (join.whitelist) steps.push({ title: "Get whitelisted", kind: "whitelist" });
if (join.requires.length) steps.push({ title: "Install what you need", kind: "install" });
steps.push({ title: "Add the server and join", kind: "add" });
const link = (url: string) => (isExternal(url) ? { href: url, rel: "noopener", target: "_blank" } : { href: href(url) });
---
<BaseLayout title={`How to join ${server.name}`} description={`Get whitelisted, install what you need and join ${server.name}, the ${studio.name} ${server.game} server.`}>
  <section class="wrap head">
    <nav aria-label="Breadcrumb" class="crumbs"><a href={href("/servers/")}>Servers</a><span aria-hidden="true">/</span><span aria-current="page">{server.name}</span></nav>
    <h1 class="display">How to join {server.name}</h1>
    <p class="lead muted">{server.game}{server.note ? `. ${server.note}` : ""}</p>
  </section>

  <section class="wrap status-wrap" aria-label="Server status">
    <ServerList servers={[server]} showJoin={false} />
  </section>

  <ol class="wrap steps">
    {steps.map((step, i) => (
      <li class="step">
        <span class="num" aria-hidden="true">{i + 1}</span>
        <div class="step-body">
          <h2>{step.title}</h2>

          {step.kind === "whitelist" && join.whitelist && (
            <>
              <p>{join.whitelist.how}</p>
              <a class="btn btn-primary" {...link(join.whitelist.url)}>
                {join.whitelist.url.includes("discord") && <Icon name="discord" />}{join.whitelist.label}
              </a>
            </>
          )}

          {step.kind === "install" && (
            <ul class="reqs">
              {join.requires.map((r) => (
                <li>
                  <strong>{r.url ? <a {...link(r.url)}>{r.name}</a> : r.name}</strong>
                  {r.detail && <span class="muted">{r.detail}</span>}
                </li>
              ))}
            </ul>
          )}

          {step.kind === "add" && (
            <>
              <ol class="sub">
                <li>Start the game{join.requires.length ? " with the profile you just set up" : ""} and open <strong>Multiplayer</strong>.</li>
                <li>Choose <strong>Add Server</strong>, give it any name, and paste the address below into <strong>Server Address</strong>.</li>
                <li>Choose <strong>Done</strong>, select the server in the list and choose <strong>Join Server</strong>.</li>
              </ol>
              <p class="addr-line">
                <code>{server.address}</code>
                <button type="button" class="copy-addr" data-copy={server.address}>Copy address</button>
              </p>
            </>
          )}
        </div>
      </li>
    ))}
  </ol>

  {join.rules.length > 0 && (
    <section class="wrap rules" aria-labelledby="rules-title">
      <h2 id="rules-title">Server rules</h2>
      <ul>{join.rules.map((r) => <li>{r}</li>)}</ul>
    </section>
  )}

  {studio.links.discord && (
    <section class="wrap help">
      <p>Stuck on a step? Ask in the Discord and someone will help.</p>
      <a class="btn" href={href("/discord/")}><Icon name="discord" />Get help on Discord</a>
    </section>
  )}
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-addr").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = "Copy address"), 1800);
      } catch { btn.textContent = "Select the address to copy"; }
    });
  });
</script>

<style>
  .head { padding-block: 32px 24px; }
  .crumbs { display: flex; gap: 10px; font-size: var(--step--1); color: var(--muted); margin-bottom: clamp(24px, 5vw, 44px); }
  .crumbs a { color: var(--muted); text-underline-offset: 3px; }
  h1 { font-size: var(--step-4); line-height: 1.02; max-width: 18ch; }
  .lead { font-size: var(--step-1); margin-top: 16px; max-width: 56ch; }
  .status-wrap { padding-bottom: 24px; max-width: 760px; margin-left: max(var(--gutter), (100% - var(--page)) / 2); }

  .steps { list-style: none; padding: 0; margin: 0 auto; display: grid; gap: 0; }
  .step { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 20px; padding-block: 32px; border-top: 1px solid var(--line); max-width: 860px; }
  .num { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--studio); color: var(--on-studio); font-weight: 800; font-stretch: var(--wide); font-size: 1.1rem; }
  .step-body { display: grid; gap: 14px; justify-items: start; }
  .step-body h2 { font-size: var(--step-2); font-stretch: var(--wide); padding-top: 6px; }
  .step-body p { color: #c9cdd6; max-width: 60ch; }
  .reqs { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; width: 100%; max-width: 620px; }
  .reqs li { display: grid; gap: 2px; padding: 12px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .reqs a { color: var(--studio); text-underline-offset: 3px; }
  .reqs span { font-size: var(--step--1); }
  .sub { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; color: #c9cdd6; max-width: 62ch; }
  .addr-line { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .addr-line code { font: inherit; font-weight: 700; font-size: var(--step-1); padding: 8px 14px; border-radius: 8px; background: var(--surface); border: 1px solid var(--line); }
  .copy-addr { font: inherit; font-weight: 600; min-height: 44px; padding: 0 14px; border-radius: 8px; border: 1px solid var(--line); background: none; color: var(--text); cursor: pointer; }
  .copy-addr:hover { background: var(--surface); }

  .rules { padding-block: 32px; border-top: 1px solid var(--line); }
  .rules h2 { font-size: var(--step-2); font-stretch: var(--wide); margin-bottom: 12px; }
  .rules ul { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; color: #c9cdd6; max-width: 62ch; }
  .help { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding-block: 28px 56px; border-top: 1px solid var(--line); }
  .help p { color: var(--muted); }

  @media (max-width: 560px) {
    .step { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
