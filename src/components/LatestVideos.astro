---
// The newest uploads from the YouTube channel, read from its public feed
// when the site builds. Renders nothing until the channel has a video.
import { studio } from "../site.config";
import { latestVideos } from "../lib/social";
import { formatDate } from "../lib/releases";

const videos = await latestVideos(studio.youtubeChannelId, 3, {
  since: studio.youtubeSince,
  hidden: studio.youtubeHidden,
});
---
{videos.length > 0 && (
  <section class="section wrap" aria-labelledby="videos-title">
    <div class="section-head">
      <h2 id="videos-title">Latest videos</h2>
      {studio.links.youtube && <a class="all" href={studio.links.youtube} rel="noopener" target="_blank">All videos on YouTube</a>}
    </div>
    <ul class="videos">
      {videos.map((v) => (
        <li>
          <a href={v.url} rel="noopener" target="_blank">
            <span class="thumb">
              <img src={v.thumbnail} alt="" loading="lazy" width="480" height="360" />
              <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
            </span>
            <span class="v-title">{v.title}</span>
            <small class="muted"><time datetime={v.published.toISOString()}>{formatDate(v.published)}</time></small>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .all { color: var(--muted); font-weight: 600; text-underline-offset: 4px; }
  .all:hover { color: var(--text); }
  .videos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 20px; }
  .videos a { display: grid; gap: 8px; text-decoration: none; }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .play { position: absolute; inset: 0; margin: auto; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: rgba(21, 23, 28, 0.78); color: #fff; }
  .play svg { width: 26px; height: 26px; margin-left: 3px; }
  .videos a:hover .play { background: #ff0033; }
  .v-title { font-weight: 650; line-height: 1.35; }
  small { font-size: var(--step--1); }
</style>
